  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
