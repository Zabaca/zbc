{
  "$schema": "node_modules/wrangler/config-schema.json",
  // walgit as a Durable-Object-bound Cloudflare Container: one Bun process
  // serving git smart-HTTP (worker/index.ts proxies straight to it), with the
  // write-ahead log in R2 reached over the S3 API from inside the container.
  // Container-backed: needs Docker running locally at apply time and a Workers
  // Paid plan with Containers enabled.
  //
  // Generic defaults only — per-project identity (the worker name, the custom
  // domain, the secrets) lives in the zbc instance file, so this file is
  // identical across projects.
  "name": "walgit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "WalgitContainer",
      "image": "./Dockerfile",
      // 1 GiB, and the tier above it was paying for a copy nobody needed.
      //
      // The old sizing said "git is not memory-hungry until it packs, and
      // `git repack -adf` on a 250 MiB repository is the sizing case". Measured,
      // that is not what happens. Repacking a 250 MiB repository — the
      // `WALGIT_MAX_REPO_BYTES` cap — peaks at 82 MiB RSS. git is never the
      // sizing case. What follows the repack is: `compact.ts` reads the produced
      // pack into memory to hash and upload it, and peak RSS for the whole
      // operation is ~583 MiB.
      //
      // Half of that is avoidable and is being removed separately: a Node
      // `Buffer` already IS a `Uint8Array`, so `new Uint8Array(readFileSync(…))`
      // allocates a second full copy of every pack (+502 MiB for a 250 MiB file,
      // against +251 MiB without the wrapper, same digest). Once that lands the
      // peak is ~330 MiB and this tier is roomy rather than merely adequate.
      //
      // Headroom to keep in mind when raising `WALGIT_MAX_REPO_BYTES` or
      // `WALGIT_MAX_PUSH_BYTES`: one container serves concurrent requests and
      // each in-flight push buffers its own pack, so two simultaneous 99 MiB
      // pushes cost ~400 MiB today and ~200 MiB after the copy goes. Nothing
      // bounds how many land at once, which is the real limit on sizing down
      // again.
      "instance_type": "basic",
      // One instance, deliberately — see worker/index.ts. The disk is a cache,
      // so a second instance is correct but starts cold and materializes
      // everything it serves.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "WalgitContainer", "name": "WALGIT_CONTAINER" },
      // The ref-event stream's rendezvous: one object holding every subscriber's
      // socket, so a push published in one colo reaches a client connected to
      // another (worker/events-do.ts). Bound unconditionally — the endpoints
      // only exist when WALGIT_EVENTS_TOKEN is set, and an unused binding costs
      // nothing.
      { "class_name": "WalgitEvents", "name": "WALGIT_EVENTS" }
    ]
  },
  // Request-level telemetry: clones, bytes served, latency, cold starts and
  // refusals by kind — the half of observability the write-ahead log cannot
  // produce (shared/telemetry.ts). Storage and push volume are NOT written
  // here; `walgit usage` derives those from the log, and a second copy would
  // disagree with it. Analytics Engine keeps the data inside the account.
  "analytics_engine_datasets": [{ "binding": "WALGIT_METRICS", "dataset": "walgit_requests" }],
  // The expiry sweeper's timer (worker/index.ts's `scheduled`). DAILY, and the
  // cost it trades away is stated rather than left to be discovered: the window
  // is `WALGIT_RETENTION_HOURS`, so a daily sweep lets a repository linger up
  // to a further 24 hours past it — a 24-hour retention collects somewhere
  // between 24 and 48 hours after the last push. Over-retaining is the safe
  // direction; nothing is collected EARLY.
  //
  // It was hourly, and the reason it is not is the half of the cost the old
  // comment named without weighing: "a sweep with nothing to collect is one
  // delimited LIST plus a container wake". A wake is not free the way a LIST
  // is. `WalgitContainer.sleepAfter` is 20m, so an hourly sweep holds the
  // container up for at least a third of every hour on a deployment with no
  // traffic at all, and the sweeper is the only thing asking. Daily makes the
  // floor a twenty-fourth of that.
  //
  // Safe in every deployment that shares this file, including a preview one:
  // expiry is off unless `WALGIT_RETENTION_HOURS` is set, and the container
  // then exposes no sweep endpoint at all, so the cron logs a 404 and collects
  // nothing. Unlike a route, a Cron Trigger is per-Worker rather than per-zone,
  // so it cannot be stolen by another deployment of this same config.
  "triggers": { "crons": ["0 4 * * *"] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WalgitContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["WalgitEvents"] }
  ]
  // No r2_buckets binding. The container writes the log itself, outside the
  // Worker's binding graph, so it needs real S3 credentials (WALGIT_S3_*) —
  // a binding here would reach only the Worker, which never touches the log.
}
