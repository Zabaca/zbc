{
  "$schema": "node_modules/wrangler/config-schema.json",
  // walgit as a Durable-Object-bound Cloudflare Container: one Bun process
  // serving git smart-HTTP (worker/index.ts proxies straight to it), with the
  // write-ahead log in R2 reached over the S3 API from inside the container.
  // Container-backed: needs Docker running locally at apply time and a Workers
  // Paid plan with Containers enabled.
  //
  // Generic defaults only — per-project identity (the worker name, the custom
  // domain, the secrets) lives in the zbc instance file, so this file is
  // identical across projects.
  "name": "walgit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The link-preview card (assets/agentgit-og.png, shared/og-image.ts) travels
  // in the Worker bundle as bytes: a crawler fetching the picture must not
  // wake the container any more than a reader fetching the page does, and a
  // 40 KB flat-colour PNG is cheaper to carry than a second service to fetch
  // it from. `Data` is the loader that makes `import png from './x.png'` the
  // file's ArrayBuffer (worker/assets.d.ts declares that for TypeScript).
  // `fallthrough` so wrangler's own default Data rule (`**/*.bin`) still
  // applies after this one; without it wrangler warns that this rule silently
  // replaces the built-in.
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  "containers": [
    // The container walgit runs in: the `durable_object` scheduling policy,
    // driven by `WalgitDurableContainer` (worker/durable-container.ts) through
    // `ctx.container`. Under this policy wrangler configures almost nothing —
    // which image may be started, and that is all. The instance size is chosen
    // in code at each start (`CONTAINER_INSTANCE`, shared/container-lifecycle.ts,
    // which says why it is `standard-1`); there is no `max_instances`, because
    // the policy has none and one named object already means one container; and
    // there are no rollouts, because the Durable Object decides when a running
    // container is replaced (it fingerprints the image it booted from). What the
    // policy adds is a start in well under a second and filesystem snapshots,
    // which `WALGIT_SNAPSHOTS` turns on.
    //
    // No `name`: wrangler derives `<worker>-<class>`, which differs from the
    // retired `default`-policy entry's because the class does — and an explicit
    // name would be shared by every deployment of this file in an account.
    {
      "class_name": "WalgitDurableContainer",
      "scheduling_policy": "durable_object",
      // Read as `ctx.container.images.walgit`: a digest-pinned reference that
      // changes exactly when this image does.
      "images": { "walgit": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      // The container's object. `WalgitContainer`, the `default`-policy class
      // this replaced, keeps its export and its `v1` migration (its namespace
      // exists) but is bound to nothing: a deployment still on it moves in
      // the three phases README.md, "Deployment", describes, with the release
      // that carried both bindings.
      { "class_name": "WalgitDurableContainer", "name": "WALGIT_DURABLE_CONTAINER" },
      // The ref-event stream's rendezvous: one object holding every subscriber's
      // socket, so a push published in one colo reaches a client connected to
      // another (worker/events-do.ts). Bound unconditionally — the endpoints
      // only exist when WALGIT_EVENTS_TOKEN and WALGIT_EVENTS_URL are BOTH set
      // (shared/capabilities.ts), and an unused binding costs nothing.
      { "class_name": "WalgitEvents", "name": "WALGIT_EVENTS" }
    ]
  },
  // Request-level telemetry: clones, bytes served, latency, cold starts and
  // refusals by kind — the half of observability the write-ahead log cannot
  // produce (shared/telemetry.ts). Storage and push volume are NOT written
  // here; `walgit usage` derives those from the log, and a second copy would
  // disagree with it. Analytics Engine keeps the data inside the account.
  "analytics_engine_datasets": [{ "binding": "WALGIT_METRICS", "dataset": "walgit_requests" }],
  // The expiry sweeper's timer (worker/index.ts's `scheduled`). DAILY, and the
  // cost it trades away is stated rather than left to be discovered: the window
  // is `WALGIT_RETENTION_HOURS`, so a daily sweep lets a repository linger up
  // to a further 24 hours past it — a 24-hour retention collects somewhere
  // between 24 and 48 hours after the last push. Over-retaining is the safe
  // direction; nothing is collected EARLY.
  //
  // Two expressions, not one, because collection is two steps: the 04:00 sweep
  // only TOMBSTONES an expired repository (a clone already in flight must be
  // allowed to finish, `src/delete-repo.ts`), and with one daily sweep the
  // removal then waited a whole day for the next one — 48 to 72 hours, not the
  // 24 to 48 above. The 05:15 sweep collects only, a grace period after the
  // first, so removal lands 75 minutes after the tombstone. Both expressions are `SWEEP_CRON` and `COLLECT_CRON` in
  // `shared/protocol.ts`, which is how the Worker tells them apart; edit them
  // together. The second costs one more container wake a day.
  //
  // It was hourly, and the reason it is not is the half of the cost the old
  // comment named without weighing: "a sweep with nothing to collect is one
  // delimited LIST plus a container wake". A wake is not free the way a LIST
  // is. `WALGIT_SLEEP_AFTER` is 20m unless set, so an hourly sweep holds the
  // container up for at least a third of every hour on a deployment with no
  // traffic at all, and the sweeper is the only thing asking. Daily makes the
  // floor a twenty-fourth of that.
  //
  // Safe in every deployment that shares this file, including a preview one:
  // expiry is off unless `WALGIT_RETENTION_HOURS` is set, and the container
  // then exposes no sweep endpoint at all, so the cron logs a 404 and collects
  // nothing. Unlike a route, a Cron Trigger is per-Worker rather than per-zone,
  // so it cannot be stolen by another deployment of this same config.
  "triggers": { "crons": ["0 4 * * *", "15 5 * * *"] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WalgitContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["WalgitEvents"] },
    // A new namespace rather than a renamed one: the old namespace is attached
    // to the `default`-policy application, and a namespace attaches to one.
    // Never removed to roll back: `wrangler rollback` refuses to cross a
    // Durable Object class change, so rolling back is a forward deploy that
    // unsets `WALGIT_CONTAINER_POLICY`, with this migration and the class kept.
    { "tag": "v3", "new_sqlite_classes": ["WalgitDurableContainer"] }
  ]
  // No r2_buckets binding. The container writes the log itself, outside the
  // Worker's binding graph, so it needs real S3 credentials (WALGIT_S3_*) —
  // a binding here would reach only the Worker, which never touches the log.
}
