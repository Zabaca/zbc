# walgit sshd. Everything here narrows what a session can be: the forced command
# on each authorized key is the real gate, and this file removes every other way
# in.

# 2222, not 22. Fly's own `hallpass` — the agent behind `fly ssh console` —
# binds port 22 on the machine's private 6PN address, and sshd listening on
# every address takes it first. hallpass then fails to bind in a loop and Fly's
# init brings the machine down with it, which presents as a kernel panic
# ("Attempted to kill init") one second after boot with nothing in the log to
# say why. The public port stays 22: fly.toml maps it to this one.
Port 2222
AddressFamily any
HostKey /etc/ssh/ssh_host_ed25519_key

# Only the `git` account, only by public key.
AllowUsers git
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /srv/walgit/.ssh/authorized_keys

# git speaks over the session channel and needs nothing else. A forwarded port
# would turn a repo credential into network access to the machine.
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no

# Fly Proxy holds the client connection; sshd sees only the proxy, so keepalives
# here are what notice a client that vanished mid-fetch.
ClientAliveInterval 60
ClientAliveCountMax 3

# Machines stop when idle and start on a raw TCP connection, so an unauthenticated
# connection is a real cost, not just a socket. Keep the window short.
LoginGraceTime 20
MaxStartups 20:30:60

# stderr, so Fly captures it in the machine log rather than a file on a disk
# that disappears.
LogLevel INFO
