{
  // The container half: src/ (the process) and e2e/ (the suite that drives it),
  // both compiled against bun's ambient types. shared/ is included here AND in
  // tsconfig.worker.json on purpose — a module in shared/ imports no runtime,
  // and being typechecked once under @types/bun and once under
  // @cloudflare/workers-types is what makes that a rule the build enforces
  // rather than a comment (docs/adr/0010).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "e2e", "shared"]
}
