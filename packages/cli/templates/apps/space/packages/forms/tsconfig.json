{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "@types/bun"],
    "strict": true,
    "resolveJsonModule": true,
    "paths": { "@forms/declaration": ["../workspace/northfield/workspace.json"] },
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test", "e2e", "dev", "scripts"]
}
