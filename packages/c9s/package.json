{
  "name": "@zabaca/c9s",
  "version": "0.3.0",
  "description": "k9s for Cloudflare: a terminal UI for Workers, Containers, Durable Objects, D1, R2, KV and Queues",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "cloudflare",
    "workers",
    "tui",
    "k9s",
    "terminal",
    "durable-objects",
    "d1",
    "r2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zabaca/zbc.git",
    "directory": "packages/c9s"
  },
  "bin": {
    "c9s": "./bin/c9s.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.tsx",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "demo": "bun run src/cli.tsx --demo",
    "frames": "FORCE_COLOR=3 bun run scripts/frames.tsx",
    "test": "bun test src",
    "publish:npm": "bun publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0"
  }
}
