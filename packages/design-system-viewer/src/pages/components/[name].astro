---
import Chrome from '../../layouts/Chrome.astro'
import { COMPONENT_REGISTRY } from '../../showcases/components'
import { Section, Container, Stack, Measure } from '@zbc/design-system'

export function getStaticPaths() {
  return Object.keys(COMPONENT_REGISTRY).map(name => ({ params: { name } }))
}

const { name } = Astro.params
const entry = COMPONENT_REGISTRY[name as string]
if (!entry) return Astro.redirect('/404')
const Showcase = entry.Showcase
---

<Chrome title={`${entry.label} — Prose DS`}>
  {/* ---- Component header ---- */}
  <Section style={{ paddingBottom: 'var(--spacing-9)' }}>
    <Container>
      <Stack gap="md">
        <Measure
          size="display"
          as="h1"
          style={{
            fontSize: 'clamp(2rem, 5vw, var(--text-3xl))',
            lineHeight: 'var(--leading-tight)',
            letterSpacing: 'var(--tracking-tighter)',
            fontWeight: 400,
          }}
        >
          {entry.label}
        </Measure>
        <Measure as="p" style={{ margin: 0 }}>
          {entry.description}
        </Measure>
      </Stack>
    </Container>
  </Section>

  {/* ---- Showcase (full-bleed) ---- */}
  <div style="border-top: 1px solid var(--color-paper-3);">
    <Showcase />
    {/* Static render — Astro can't apply client:load to a runtime variable.
        Newsletter form renders but won't react to submit; fine for visual review. */}
  </div>
</Chrome>
